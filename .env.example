# q-matrix-agents — environment configuration
#
# Copy this file to `.env` in the repo root and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored. Never commit it, and never paste a real key into this
# example file.


# ─── Required ────────────────────────────────────────────────────────────────

# REQUIRED. Absolute path to your local clone of the knowledge base repo.
# Every read and write the pipeline performs resolves against this path.
# skills/kb_access.py raises EnvironmentError at import time if this is unset,
# so nothing in the repo runs without it — not even the test scripts.
#
# Use a repo you own and can push to: the orchestrator runs `git pull --rebase`
# at the start of a run and `git add`/`commit`/`push` at the end, inside KB_ROOT.
# Pass --no-sync to disable both (recommended for first runs).
#
# macOS / Linux:
KB_ROOT=/Users/you/code/q-matrix-kb-template
# Windows (note the doubled backslashes are NOT needed; a raw path is fine):
# KB_ROOT=C:\Users\you\code\q-matrix-kb-template

# REQUIRED. Vercel AI Gateway API key — https://vercel.com/docs/ai-gateway
# One key routes to Anthropic, OpenAI, Google, Mistral, DeepSeek, etc. This is
# the key that gets billed for every agent call. Running the pipeline costs
# real money (see docs/SETUP.md § Cost).
AI_GATEWAY_API_KEY=vck_your_gateway_key_here


# ─── Optional ────────────────────────────────────────────────────────────────

# TEST-ONLY. Read by tests/test_skills.py and nothing else. The pipeline itself
# never uses it — you do not need it to run the orchestrator, the API, or the
# dashboard. Leave it unset unless you are running that one test script.
# ANTHROPIC_API_KEY=sk-ant-your_key_here


# ─── Not here ────────────────────────────────────────────────────────────────
#
# NEXT_PUBLIC_API_URL belongs in `dashboard/.env.local`, not in this file.
# Next.js reads its own env file; putting it here has no effect.
# See dashboard/.env.local.example.
