# q-matrix-agents dashboard — environment configuration
#
# Copy this file to `.env.local` in this directory:
#     cp .env.local.example .env.local
#
# REQUIRED. Base URL of the FastAPI backend (api.py). The dashboard calls it
# cross-origin directly — for run submission, KB browsing, analytics, and the
# SSE event stream. If this is unset, requests fall back to a relative path and
# hit the Next.js server instead, so the dashboard will show no boards and no
# live stream.
#
# Must match the port you start uvicorn on:
#     uvicorn api:app --reload --port 8000
#
# The backend CORS-allowlists http://localhost:3000 only, so run the dashboard
# on port 3000. Localhost development only — the backend has no authentication.
NEXT_PUBLIC_API_URL=http://localhost:8000
